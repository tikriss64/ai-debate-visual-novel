# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Opciones extra (todas opcionales, con valores por defecto sensatos) ---

# MOCK_AI: pon "true" para el modo demo (respuestas simuladas, sin usar la API ni cuota).
# MOCK_AI="true"

# Modelos de Gemini (valores por defecto ya optimizados):
#  - Personajes: gemini-3.1-flash-lite (rápido y con cuota gratuita amplia: ~1000 req/día)
#  - Moderador:  gemini-3.5-flash (mayor calidad para el veredicto; solo 1 llamada)
# Puedes sobrescribirlos si quieres más calidad en los personajes (gemini-3.5-flash)
# o probar otra variante:
# GEMINI_MODEL_CHARACTERS="gemini-3.1-flash-lite"
# GEMINI_MODEL_MODERATOR="gemini-3.5-flash"

# WEB_SEARCH: búsqueda factual gratuita (DuckDuckGo) en la Fase 1. Activada por defecto.
# Ponla en "false" para desactivarla. Si la búsqueda falla, el debate continúa igual.
# WEB_SEARCH="false"
